{
  "name": "loupe",
  "displayName": "Loupe",
  "description": "A close-up of your Android app inside VS Code: live emulator or phone mirror with touch input, device buttons, and Flutter or React Native reload controls.",
  "version": "0.2.0",
  "publisher": "tuzkituan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tuzkituan/loupe.git"
  },
  "bugs": {
    "url": "https://github.com/tuzkituan/loupe/issues"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "flutter",
    "react-native",
    "expo",
    "android",
    "emulator",
    "scrcpy",
    "mirror"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:loupe.device",
    "workspaceContains:pubspec.yaml",
    "workspaceContains:metro.config.js",
    "workspaceContains:app.json"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "loupe",
          "title": "Loupe",
          "icon": "media/device.svg"
        }
      ]
    },
    "views": {
      "loupe": [
        {
          "type": "webview",
          "id": "loupe.device",
          "name": "Device"
        }
      ]
    },
    "commands": [
      {
        "command": "loupe.selectDevice",
        "title": "Select Device",
        "category": "Loupe",
        "icon": "$(device-mobile)"
      },
      {
        "command": "loupe.manageEmulators",
        "title": "Start or Stop an Emulator",
        "category": "Loupe",
        "icon": "$(vm)"
      },
      {
        "command": "loupe.reconnect",
        "title": "Reconnect Mirror",
        "category": "Loupe",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "loupe.screenshot",
        "title": "Save Screenshot",
        "category": "Loupe",
        "icon": "$(device-camera)"
      },
      {
        "command": "loupe.copyScreenshot",
        "title": "Copy Screenshot to Clipboard",
        "category": "Loupe"
      },
      {
        "command": "loupe.toggleRecording",
        "title": "Start or Stop Screen Recording",
        "category": "Loupe",
        "icon": "$(record)"
      },
      {
        "command": "loupe.runApp",
        "title": "Run App on Mirrored Device",
        "category": "Loupe",
        "icon": "$(debug-start)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "loupe.selectDevice",
          "when": "view == loupe.device",
          "group": "navigation@1"
        },
        {
          "command": "loupe.manageEmulators",
          "when": "view == loupe.device",
          "group": "navigation@2"
        },
        {
          "command": "loupe.reconnect",
          "when": "view == loupe.device",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "Loupe",
      "properties": {
        "loupe.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Open the Device view in the secondary side bar when a Flutter or React Native project is opened."
        },
        "loupe.framework": {
          "type": "string",
          "enum": [
            "auto",
            "flutter",
            "reactNative"
          ],
          "enumDescriptions": [
            "Detect from pubspec.yaml or package.json. If both are present, Flutter wins.",
            "Always show the Flutter controls.",
            "Always show the React Native controls."
          ],
          "default": "auto",
          "description": "Which run-loop controls the Device view shows."
        },
        "loupe.metroPort": {
          "type": "number",
          "default": 8081,
          "description": "Port of the Metro (or Expo) dev server, for React Native reload, dev menu and DevTools."
        },
        "loupe.sdkPath": {
          "type": "string",
          "default": "",
          "description": "Android SDK folder. When empty: ANDROID_HOME, then ANDROID_SDK_ROOT, then ~/Android/Sdk (Linux), ~/Library/Android/sdk (macOS) or %LOCALAPPDATA%\\Android\\Sdk (Windows)."
        },
        "loupe.adbPath": {
          "type": "string",
          "default": "",
          "description": "adb executable. When empty: <sdk>/platform-tools/adb, then adb on PATH. Using the SDK copy keeps it the same version Flutter uses, so the two do not restart each other's adb server."
        },
        "loupe.scrcpyServerPath": {
          "type": "string",
          "default": "",
          "description": "scrcpy-server file. When empty it is looked up next to the scrcpy install (for example /usr/share/scrcpy/scrcpy-server)."
        },
        "loupe.scrcpyVersion": {
          "type": "string",
          "default": "",
          "description": "Version of the scrcpy-server file. It must match the file exactly. When empty it is read from `scrcpy --version`."
        },
        "loupe.maxSize": {
          "type": "number",
          "default": 1280,
          "minimum": 0,
          "description": "Longest side of the mirrored video in pixels. 0 streams at the device's full resolution."
        },
        "loupe.maxFps": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Frame-rate cap for the mirrored video."
        },
        "loupe.bitRate": {
          "type": "number",
          "default": 8000000,
          "description": "Video bit rate in bits per second."
        },
        "loupe.captureFolder": {
          "type": "string",
          "default": ".screenshots",
          "description": "Folder for screenshots and recordings, relative to the first workspace folder (or absolute)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "test": "vitest run",
    "package": "npm run build -- --production && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build -- --production"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "^1.106.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
